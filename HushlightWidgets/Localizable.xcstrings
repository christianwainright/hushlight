    "One tap starts the timing; the next ends it.": {
      "comment": "Control gallery description of the Control Center control that starts or ends a contraction",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un toque empieza a cronometrar; el siguiente lo termina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un toucher démarre le chronométrage ; le suivant l’arrête."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tipp startet die Messung, der nächste beendet sie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tocco avvia il conteggio; il successivo lo termina."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um toque começa a marcação; o seguinte a encerra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1回のタップで計測を開始し、次のタップで終了します。"
