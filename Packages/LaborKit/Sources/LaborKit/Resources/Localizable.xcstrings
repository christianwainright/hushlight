    "Open Hushlight to time this one.": {
      "comment": "Siri/Shortcuts reply, only if the start/stop intent ever runs outside the app and so cannot record — the user should open the app and tap there",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Hushlight para cronometrar esta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Hushlight pour chronométrer celle-ci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
