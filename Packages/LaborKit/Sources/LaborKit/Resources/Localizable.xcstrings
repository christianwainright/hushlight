    "Everything stays on this phone. No account, no analytics, nothing sent anywhere.": {
      "comment": "privacy statement shown directly under the disclaimer on the Guidance screen — three factual clauses about the binary, not a promise",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles bleibt auf diesem Telefon. Kein Konto, keine Analyse, nichts wird irgendwohin gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything stays on this phone. No account, no analytics, nothing sent anywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo se queda en este teléfono. Sin cuenta, sin analítica, nada se envía a ningún lado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout reste sur ce téléphone. Pas de compte, pas de statistiques, rien n’est envoyé nulle part."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto resta su questo telefono. Nessun account, nessuna analisi, niente viene inviato da nessuna parte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてこの端末に残ります。アカウントなし、解析なし、どこにも送信しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 것이 이 기기에 남아요. 계정 없음, 분석 없음, 어디로도 전송하지 않아요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo fica neste telefone. Sem conta, sem análises, nada é enviado a lugar nenhum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一切都留在这部手机上。没有账户，没有分析，不向任何地方发送。"
          }
        }
      }
    },
