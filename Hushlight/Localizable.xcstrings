    "Drafts an email you can read and edit before sending. Your contraction times are never included.": {
      "comment": "Guidance screen: caption under the Report a problem button, stating the email is a draft and never carries contraction times",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entwirft eine E-Mail, die du vor dem Senden lesen und ändern kannst. Deine Wehenzeiten sind nie enthalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drafts an email you can read and edit before sending. Your contraction times are never included."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Redacta un correo que puedes leer y editar antes de enviar. Los horarios de tus contracciones nunca se incluyen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rédige un e-mail que vous pouvez lire et modifier avant l’envoi. Les horaires de vos contractions n’y figurent jamais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepara un’email che puoi leggere e modificare prima di inviarla. Gli orari delle tue contrazioni non sono mai inclusi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信前に読んで編集できるメールを下書きします。陣痛の時刻が含まれることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보내기 전에 읽고 고칠 수 있는 이메일을 작성해요. 진통 시각은 절대 포함되지 않아요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepara um e-mail que você pode ler e editar antes de enviar. Os horários das suas contrações nunca são incluídos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "起草一封你可以在发送前阅读和修改的邮件。你的宫缩时间从不包含在内。"
          }
        }
      }
    },
