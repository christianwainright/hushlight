    },
    "None of these wait for a timer. Call your provider or labor and delivery directly.": {
      "comment": "Guidance screen: closes the call-right-away card, stating these situations don't wait for the pattern",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts davon wartet auf eine Uhr. Ruf direkt deine Hebamme, deine Ärztin oder den Kreißsaal an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None of these wait for a timer. Call your provider or labor and delivery directly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada de esto espera a un cronómetro. Llama directamente a tu profesional o a la sala de partos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien de tout cela n’attend un chronomètre. Appelez directement votre professionnel de santé ou la maternité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente di tutto questo aspetta un cronometro. Chiama direttamente la tua ostetrica, il tuo medico o la sala parto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どれも計測を待つ必要はありません。助産師さん・医師・産院に直接連絡してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 중 어느 것도 측정을 기다리지 않아요. 담당 의료진이나 분만실로 바로 연락하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada disso espera um cronômetro. Ligue direto para sua obstetra, seu médico ou a maternidade."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些都不需要等计时。直接联系你的助产士、医生或产房。"
          }
        }
      }
    },
    "Not at %@ yet — averaging %@ apart and %@ long over %lld timed contractions.%@": {
