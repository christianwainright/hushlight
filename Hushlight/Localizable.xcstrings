    "This iPad keeps its own record. Nothing here is shared with your iPhone or with anyone.": {
      "comment": "Guidance screen, iPad only: under the disclaimer, stating that records are not shared between devices",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses iPad führt seine eigene Aufzeichnung. Nichts davon wird mit deinem iPhone oder mit irgendjemandem geteilt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPad keeps its own record. Nothing here is shared with your iPhone or with anyone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPad guarda su propio registro. Nada de esto se comparte con tu iPhone ni con nadie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet iPad tient son propre relevé. Rien ici n’est partagé avec votre iPhone ni avec qui que ce soit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo iPad tiene il proprio registro. Niente di questo viene condiviso con il tuo iPhone né con nessuno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPadは独自の記録を保持します。ここにある内容はiPhoneにも誰にも共有されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPad는 자체 기록을 보관합니다. 여기 있는 내용은 iPhone이나 다른 누구와도 공유되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPad mantém o próprio registro. Nada daqui é compartilhado com o seu iPhone nem com ninguém."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台iPad保存自己的记录。这里的内容不会与你的iPhone或任何人共享。"
          }
        }
      }
