    "Each one you time appears here as it happens, with the gap since the one before.": {
      "comment": "Ledger pane (iPad) empty state, under the headline: what will appear here once a contraction is timed",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede gemessene Wehe erscheint hier sofort, mit dem Abstand zur vorigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each one you time appears here as it happens, with the gap since the one before."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada contracción que midas aparece aquí al momento, con el intervalo desde la anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque contraction chronométrée apparaît ici aussitôt, avec l’écart depuis la précédente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni contrazione che cronometri compare qui subito, con l’intervallo dalla precedente."
          }
