        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: contrazioni ogni %2$#@minutesArg@ o meno, ciascuna di circa un minuto, per un’ora senza lunghe pause. Il cronometro legge tutti e tre i dati dai tuoi tocchi e lo dice quando il ritmo c’è."
          },
          "substitutions": {
