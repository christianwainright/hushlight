    "%@: contractions every %lld minute or closer, each lasting about a minute, sustained for an hour without a long break in it. The timer reads all three from your taps and says so when the pattern is there.": {
      "comment": "Guidance screen: states the selected guideline rule in full sentence form, naming the interval, duration and sustained-window figures it uses — catalog plural entry on the minutes argument",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: Wehen alle %2$#@minutesArg@ oder enger, jede etwa eine Minute lang, eine Stunde lang ohne lange Pause. Die Uhr liest alle drei aus deinen Tipps und sagt es, wenn das Muster da ist."
          },
          "substitutions": {
            "minutesArg": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%2$lld Minute"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%2$lld Minuten"
                    }
                  }
                }
              }
            }
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: contractions every %2$#@minutesArg@ or closer, each lasting about a minute, sustained for an hour without a long break in it. The timer reads all three from your taps and says so when the pattern is there."
          },
          "substitutions": {
            "minutesArg": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%2$lld minute"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%2$lld minutes"
                    }
                  }
                }
              }
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: contracciones cada %2$#@minutesArg@ o menos, cada una de alrededor de un minuto, sostenidas durante una hora sin una pausa larga. El cronómetro lee las tres cosas de tus toques y lo dice cuando el patrón está."
          },
          "substitutions": {
            "minutesArg": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
